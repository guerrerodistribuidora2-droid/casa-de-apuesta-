# Copia este archivo a .env.local y rellena los valores.
# Las mismas claves hay que declararlas en Vercel > Project Settings > Environment Variables.

# --- Cuotas en directo (opcional) ---------------------------------------
# The Odds API. Sin ella el tablero funciona con los datos locales.
# Plan gratuito: 500 peticiones al mes. https://the-odds-api.com
ODDS_API_KEY=

# Proveedor secundario. Déjalo en false salvo que tengas un endpoint de cuotas.
SHARP_API_KEY=
SHARP_API_HABILITADA=false

# --- Persistencia del gestor de banca (opcional) ------------------------
# Sin estas dos, el gestor guarda solo en el navegador (localStorage).
# La clave anónima se usa SOLO desde el servidor: nunca lleva prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- PitchAPI (opcional) -------------------------------------------------
# Estadísticas avanzadas (VAEP, PPDA...) y mapas de calor por partido de
# fútbol. Sin ella, esas secciones no se muestran. https://pitchapi.dev
PITCHAPI_API_KEY=

# --- Riot Games API (reservada, sin usar todavía) -----------------------
# Guardada para no perderla, pero NO está conectada a ningún adaptador.
# TOURNAMENT-V5 y VAL-MATCH-V1 no dan un calendario de partidos profesionales
# de LoL/Valorant: el primero es para lobbies de torneo propios, el segundo
# necesita ya conocer la cuenta de cada jugador. Ver DESPLIEGUE.md antes de
# intentar usarla para "cartelera de eSports".
RIOT_API_KEY=
